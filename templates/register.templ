package templates

import (
  // "github.com/pynezz/pynezz_com/templates/layout"
)

const (
  bg        = "#1e1e2e" // catppuccin Mocha: base
  txt       = "#cdd6f4" // text
  subtxt    = "#b5bfe2" // text2
  text3     = "#a6adc8" // text3
  darkTxt   = "#313244" // surface0
  red       = "#f38ba8"
  green     = "#a6e3a1"
  overlay2  = "#9399b2" // light gray
  overlay1  = "#7f849c" // semi gray
  overlay0  = "#6c7086" // semi gray
  surface2  = "#585b70" // light gray
  surface0  = "#313244" // dark gray
  mantle    = "#181825" // darkest gray
  crust     = "#11111b" // darkest
)

css h1() {
  color: {txt};
  font-size: 2rem;
  margin-bottom: 1rem;
  font-family: "Hack Nerd Font Mono", "Fira Mono", monospace;
}

css btn(fg, bg string) {
  background-color: {bg};
  color: {fg};
  padding: 0.5rem 1rem;
  border: none;
  border-radius: 0.4rem;
  cursor: pointer;
}

css hint() {
  color: {subtxt};
  font-size: 0.8rem;
  font-family: "Hack Nerd Font Mono", "Fira Mono", monospace;
}

css input() {
  background-color: {crust};
  color: {txt};
  padding: 0.5rem 1rem;
  border: none;
  border-radius: 0.4rem;
  margin-bottom: 1rem;
}

css form() {
  display: flex;
  flex-direction: column;
  background-color: {surface0};
  color: {txt};

  padding: 2rem;
  border-radius: 0.4rem;
  box-shadow: 0 0 1rem 0.4rem {overlay0};

  max-width: 40rem;

  margin-bottom: 2rem;
  margin-top: 2rem;
}

css formDiv() {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  background-color: {bg};
  align-self: center;
  color: {txt};
  padding: 1rem;
  padding-right: 2.25rem;
  padding-left: 2.25rem;
  max-width: 50rem;
  border-radius: 0.4rem;
  margin: 0 auto;
  flex-shrink: 1;
  margin-top: 2rem;

  border-style: solid;
  border-color: {surface0};
  border-width: 0.1rem;
}
  // box-shadow: 0 0 10px 2px;
  // box-shadow-color: {overlay0};
  // border-style: dotted;

css Outer() {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100%;
  background-color: {crust};
}

css aTxt() {
  color: {text3};
  text-decoration: none;
  font-family: "Hack Nerd Font Mono", "Fira Mono", monospace;
  border-bottom: 3px dotted {subtxt};
  font-size: 0.9rem;

  padding: 0.3rem;

  background-color: {surface0};
  border-radius: 0.4rem;
}

css code() {
  background-color: {surface0};
  font-family: "Hack Nerd Font Mono", "Fira Mono", monospace;
  padding: .3rem;
  margin: .3rem;
  border-radius: 0.4rem;
}

css lighten() {
  color: {txt};
}

templ Register() {
  // <div class={"div", Style()}>
  // @layout.Header(  "Register"  )
    <div class={"div", formDiv()}
         data-store="{username: '', password: '', loading: false, error: '', success: false, passwordValid: false}"
         data-computed-passwordValid="$password.length >= 12">
      <h1 class={"h1", h1()}> Register </h1>
      <p>registration is needed to post content</p>
      
      <!-- Error message -->
      <div data-show="$error" class="bg-red text-base p-3 rounded mb-4" data-text="$error"></div>
      
      <!-- Success message -->
      <div data-show="$success" class="bg-green text-base p-3 rounded mb-4">
        Registration successful! Redirecting to login...
      </div>
      
      // Input form
      <form class={"form", form()} 
            data-on-submit="$$post('/register').then(res => { if(res.ok) { $success = true; setTimeout(() => window.location.href = '/login', 2000); } else { $error = 'Registration failed. Username may already exist.'; } }).catch(() => { $error = 'Network error. Please try again.'; }).finally(() => { $loading = false; })">
        <input class={"input", input()} 
               type="text" 
               name="username" 
               placeholder="Username" 
               data-model="username"
               data-bind-disabled="$loading"
               required />
        <input class={"input", input()} 
               type="password" 
               name="password" 
               placeholder="Password" 
               data-model="password"
               data-bind-disabled="$loading"
               required />
        <button type="submit" 
                class={"button", btn(darkTxt, green)}
                data-bind-disabled="$loading || !$username || !$passwordValid"
                data-on-click="$loading = true; $error = ''">
          <span data-show="!$loading">Register</span>
          <span data-show="$loading">Registering...</span>
        </button>
      </form>
      <i class={"i", hint()}> Password requirements<br><br>
        <code class={"code", code()} 
              data-class-text-green="$passwordValid"
              data-class-text-red="!$passwordValid && $password.length > 0">
          > 12 characters
        </code>
        <span data-show="$password.length > 0 && !$passwordValid" class="text-red text-sm ml-2">
          (<span data-text="$password.length"></span>/12)
        </span>
        <span data-show="$passwordValid" class="text-green text-sm ml-2">✓</span>
      </i>
      <br>
      <p style="display: flex; flex-direction: column; justify-content: center;"> Already have an account?
        <a href="/login" class={"a", templ.KV("hover:lighten", false), aTxt()}> Login here </a>
      </p>
    </div>
    // @layout.Footer()
  // </div>
}
