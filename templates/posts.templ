package templates

import (
	"strings"
 	"unicode/utf8"

	"github.com/pynezz/pynezz_com/templates/layout"
	"github.com/pynezz/pynezz_com/internal/server/middleware/models"
)

templ Show(title string, body string, post models.Post) {
	// <div class="flex shrink">
	// </div>
	// If no post found, show 404 and link back to home page
	if title[:3] == "404" {
		<article class="flex flex-col items-center justify-center text-center h-full py-10">
			<h1 class={ "h1", layout.Title+" pl-10" }>{ title }</h1> // Could just hard-code 404, but this is more flexible
			<p class="pb-10">{ body }</p>
			<a href={ templ.SafeURL(BaseURL) } class={ "a", layout.Link + " my-10" }>Home</a>
		</article>
	} else {
		<article class={ "article", layout.Article }>
			<h1 class={ "h1", layout.Title }>{ title }</h1>
			<p class="date text-surface2 italic font-mono px-2">{ post.Metadata.Date.Format("02. Jan 2006") } </p>
			<div class="flex flex-wrap gap-2 mb-4">
			for _, tag := range strings.Split(strings.Trim(string(post.Metadata.Tags), "[]\" "), ", ") {
				if utf8.RuneCountInString(tag) > 1 {
					<a href={ templ.SafeURL("/tags/" + strings.Trim(tag, "\"" )) } class={"a", layout.TagBtn + " bg-crust"}>{ strings.Trim(tag, "\"" ) }</a>
				}
			}
			</div>
		</article>
		<div class="bg-mantle max-w-prose w-full mb-2 mx-auto p-4 rounded-md">
			@templ.Raw(body)
		</div>
	}
}

templ PostsList(posts []models.PostMetadata) {
<div class="flex flex-col items-center justify-center flex-wrap mx-auto px-2 space-x-2 space-y-2 bg-inherit"
     data-store="{searchTerm: '', selectedTag: '', posts: [], tags: [], loading: true}"
     data-computed-filteredPosts="$posts.filter(post => { const searchTerm = $searchTerm.toLowerCase(); const selectedTag = $selectedTag; const matchesSearch = !searchTerm || post.Title.toLowerCase().includes(searchTerm) || (post.Summary && post.Summary.toLowerCase().includes(searchTerm)); const matchesTag = !selectedTag || post.Tags.toLowerCase().includes(selectedTag.toLowerCase()); return matchesSearch && matchesTag; })"
     data-on-load="$$get('/api/posts')">
		<h1 class={ "h1", layout.LinkCardTitle }>Posts</h1>
		
		<!-- Search and Filter Controls -->
		<div class="flex flex-col md:flex-row gap-4 w-full max-w-2xl mb-6">
			<input type="text" 
				   placeholder="Search posts..." 
				   class="flex-1 px-4 py-2 rounded border border-surface0 bg-mantle text-text focus:outline-none focus:border-teal"
				   data-model="searchTerm">
			
			<select class="px-4 py-2 rounded border border-surface0 bg-mantle text-text focus:outline-none focus:border-teal"
					data-model="selectedTag">
				<option value="">All Tags</option>
				<option data-for="tag in $tags" data-value="tag" data-text="tag"></option>
			</select>
			
			<button class="px-4 py-2 bg-teal text-base rounded hover:bg-sky transition-colors"
					data-on-click="$$get('/api/posts')">
				Refresh
			</button>
		</div>

		<ul class={"ul", postsList} data-show="$filteredPosts.length > 0">
			<li data-for="post in $filteredPosts" data-key="post.ID">
				<div class={"div", layout.LinkCard + " w-full"}>
					<article class="flex flex-col flex-wrap text-wrap content-between justify-between m-2 p-2">
						<span class="flex flex-col flex-wrap m-2">
							<a data-attr-href="'/posts/' + post.Slug">
								<strong class="first-letter:text-xl text-lg text-text font-semibold hover:border-b hover:border-b-sky" 
										data-text="post.Title"></strong>
							</a>
							<i class="date" data-text="new Date(post.CreatedAt).toLocaleDateString('en-GB')"></i>
							<i data-text="post.Summary || 'no summary available..'"></i>
						</span>
						<span class="flex flex-row flex-wrap m-2 pb-2">
							<span data-for="tag in post.Tags.split(',').filter(t => t.trim())" data-key="tag">
								<a data-attr-href="'/tags/' + tag.trim()" 
								   class={"a", layout.TagBtn + " bg-crust"}
								   data-text="tag.trim()"></a>
							</span>
						</span>
					</article>
				</div>
			</li>
		</ul>
		
		<div data-show="$filteredPosts.length === 0 && !$loading" class="text-center py-8">
			<p class="text-subtext1">No posts found matching your criteria.</p>
		</div>
		
		<div data-show="$loading" class="text-center py-8">
			<p class="text-subtext1">Loading posts...</p>
		</div>
	</div>
}

templ postCard(post models.PostMetadata) {
	<div class={"div", layout.LinkCard + " w-full"}>
		<article class="flex flex-col flex-wrap text-wrap content-between justify-between m-2 p-2">
			<span class="flex flex-col flex-wrap m-2	">
				<a href={ templ.URL("/posts/" + post.Slug) }><strong class="first-letter:text-xl text-lg text-text font-semibold hover:border-b hover:border-b-sky">{ post.Title }</strong></a>
				<i class="date">{ post.CreatedAt.Format("02.01.2006") }</i>
			if post.Summary != "" {
				<i>{ post.Summary }</i>
			}	else {
				<i> no summary available.. </i>
			}
			</span>
			<span class="flex flex-row flex-wrap m-2 pb-2">
					for _, tag := range strings.Split(strings.Trim(string(post.Tags), "[]\" "), ", "){
						if utf8.RuneCountInString(tag) > 1 {
							<a href={ templ.SafeURL("/tags/" + strings.Trim(tag, "\"" )) } class={"a", layout.TagBtn + " bg-crust"}>
								{ strings.Trim(tag, "\"" ) }
							</a>
						}
					}
			</span>
		</article>
	</div>
}
