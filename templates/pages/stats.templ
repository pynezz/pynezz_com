package pages

import (
  "github.com/pynezz/pynezz_com/templates/layout"
)

const secStyle = "flex flex-col space-y-3 bg-crust text-teal flex-grow w-full h-full"

templ Stats() {
  <section class={"section", secStyle} 
           data-store="{posts: 0, tags: 0, views: 0, visitors: 0, loading: true}"
           data-on-load="$$get('/api/stats')">
    <h1 class={"h1", layout.Title}>Stats</h1>
    <container class="flex flex-col space-y-3">
      <p class="font-mono font-light italic">This page (as with every page) is a work in progress. I plan to add more stats in the future.</p>
      
      <div data-show="$loading" class="text-center">
        <p class="font-mono text-subtext1">Loading stats...</p>
      </div>

      <div data-show="!$loading" class="flex flex-col flex-wrap w-max space-y-2">
        <div class="flex flex-row justify-between min-w-48">
          <p class="font-mono">Total Posts:</p>
          <p class="font-semibold" data-text="$posts"></p>
        </div>
        <div class="flex flex-row justify-between">
          <p class="font-mono whitespace-pre">Total Tags:</p>
          <p class="font-semibold" data-text="$tags"></p>
        </div>
        <div class="flex flex-row justify-between">
          <p class="font-mono">Total Views:</p>
          <p class="font-semibold" data-text="$views"></p>
        </div>
        <div class="flex flex-row justify-between">
          <p class="font-mono">Total Visitors:</p>
          <p class="font-semibold" data-text="$visitors"></p>
        </div>
        
        <button class="mt-4 px-4 py-2 bg-teal text-base rounded hover:bg-sky transition-colors"
                data-on-click="$$get('/api/stats')">
          Refresh Stats
        </button>
      </div>
    </container>
  </section>
}

script stats() {
  document.addEventListener("DOMContentLoaded", function() {
    document.body.classList.add("bg-crust");
  });
}
