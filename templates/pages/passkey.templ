package pages

import "github.com/pynezz/pynezz_com/templates/layout"

const formDiv = "flex flex-col justify-content space-between align-items-center bg-bg self-center text-txt p-4 pr-9 pl-9 max-w-50 border border-surface rounded-4 m-0-auto flex-shrink-1 mt-8"

templ Passkey() {
	<section class={ "section", formDiv }
	         data-store="{username: '', displayname: '', loading: false, error: '', success: '', mode: 'idle'}"
	         data-on-load="window.SimpleWebAuthn = SimpleWebAuthnBrowser">
		<h1 class={ "h1", layout.Title }>Passkey</h1>
		<div class="container flex justify-center items-center vh-100">
			<div class="bg-base p-5 rounded-lg border-crust border-2 w-50 h-max">
				<h1 class="mb-4 text-center">🔑 Passkey</h1>
				
				<!-- Message Display -->
				<div class="text-left text-wrap mb-4" data-show="$error || $success">
					<div data-show="$error" class="bg-red text-base p-3 rounded mb-2" data-text="$error"></div>
					<div data-show="$success" class="bg-green text-base p-3 rounded mb-2" data-text="$success"></div>
				</div>
				
				<!-- Input Fields -->
				<div class="mb-3 flex flex-col w-full gap-2">
					<input type="text" 
					       class="focus:outline-none bg-crust rounded-md p-2" 
					       placeholder="username"
					       data-model="username"
					       data-bind-disabled="$loading"/>
					<input type="text" 
					       class="focus:outline-none bg-crust rounded-md p-2" 
					       placeholder="display name"
					       data-model="displayname"
					       data-bind-disabled="$loading"/>
				</div>
				
				<!-- Action Buttons -->
				<div class="flex flex-col w-full">
					<div class="rounded border-mantle gap-2 space-y-2">
						<button class="p-2 py-4 bg-surface2 w-full h-fit shadow-md focus:outline-none text-text active:bg-surface0 rounded-sm hover:bg-sky hover:text-surface2 transition-colors disabled:opacity-50" 
						        data-bind-disabled="$loading || !$username || !$displayname"
						        data-on-click="$loading = true; $error = ''; $success = ''; $mode = 'register'; $$post('/api/passkey/register', {username: $username, displayname: $displayname}).then(async (response) => { if (!response.ok) { const error = await response.text(); throw new Error(error); } const options = await response.json(); const credential = await window.SimpleWebAuthn.startRegistration(options); return $$post('/api/passkey/verify-registration', credential); }).then(async (response) => { if (response.ok) { $success = 'Registration successful!'; } else { const error = await response.text(); $error = 'Registration failed: ' + error; } }).catch((error) => { if (error.name === 'InvalidStateError') { $error = 'Authenticator was probably already registered'; } else { $error = 'Registration error: ' + error.message; } }).finally(() => { $loading = false; })">
							<span data-show="!$loading || $mode !== 'register'">Register</span>
							<span data-show="$loading && $mode === 'register'">Registering...</span>
						</button>
						
						<button class="p-2 bg-surface2 w-full h-fit shadow-sm focus:outline-none text-text active:bg-surface0 rounded-sm hover:bg-sky hover:text-surface2 transition-colors disabled:opacity-50" 
						        data-bind-disabled="$loading"
						        data-on-click="$loading = true; $error = ''; $success = ''; $mode = 'login'; $$get('/api/passkey/generate-authentication-options').then(async (response) => { if (!response.ok) { const error = await response.text(); throw new Error(error); } const options = await response.json(); const credential = await window.SimpleWebAuthn.startAuthentication(options); return $$post('/api/passkey/verify-authentication', credential); }).then(async (response) => { if (response.ok) { $success = 'Authentication successful!'; setTimeout(() => { window.location.href = '/dashboard'; }, 1000); } else { const error = await response.text(); $error = 'Authentication failed: ' + error; } }).catch((error) => { $error = 'Authentication error: ' + error.message; }).finally(() => { $loading = false; })">
							<span data-show="!$loading || $mode !== 'login'">Login</span>
							<span data-show="$loading && $mode === 'login'">Authenticating...</span>
						</button>
					</div>
				</div>
				
				<!-- Help Text -->
				<div class="mt-4 text-sm text-subtext1">
					<p>Use your device's biometric authentication (Face ID, Touch ID, Windows Hello) or security key to register or log in.</p>
				</div>
			</div>
		</div>
	</section>
	<script src="/js/webauthn.js"></script>
}